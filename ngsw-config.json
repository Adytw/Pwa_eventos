{
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "eventpass-shell",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/*.css",
          "/*.js",
          "/manifest.webmanifest",
          "/icons/**"
        ]
      }
    },
    {
      "name": "eventpass-assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/*.(svg|png|jpg|jpeg|webp|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "eventpass-web-fonts",
      "urls": [
        "https://fonts.googleapis.com/**",
        "https://fonts.gstatic.com/**"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 10,
        "maxAge": "30d",
        "timeout": "3s"
      }
    }
  ]
}
