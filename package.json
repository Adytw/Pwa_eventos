{
  "name": "eventpass-pwa",
  "version": "1.0.0",
  "private": true,
  "description": "EventPass - plataforma PWA para administrar eventos, boletos QR y asistencia offline.",
  "scripts": {
    "start": "ng serve --host 0.0.0.0",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "preview": "http-server dist/eventpass/browser -p 8080 -c-1"
  },
  "dependencies": {
    "@angular/animations": "21.2.26",
    "@angular/common": "21.2.26",
    "@angular/compiler": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/forms": "21.2.26",
    "@angular/platform-browser": "21.2.26",
    "@angular/router": "21.2.26",
    "@angular/service-worker": "21.2.26",
    "@ionic/angular": "9.0.13",
    "@supabase/supabase-js": "^2.89.0",
    "@zxing/browser": "0.2.1",
    "dexie": "4.4.7",
    "ionicons": "8.0.13",
    "qrcode": "1.5.4",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.26",
    "@angular/cli": "21.2.26",
    "@angular/compiler-cli": "21.2.26",
    "@types/qrcode": "1.5.6",
    "typescript": "5.9.3",
    "http-server": "14.1.1"
