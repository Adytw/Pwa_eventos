{
  "id": "/",
  "name": "EventPass - Gestión de eventos",
  "short_name": "EventPass",
  "description": "Administra eventos, genera boletos QR y valida accesos sin conexión.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
